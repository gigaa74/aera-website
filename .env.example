# Set these environment variables before starting uvicorn.
AERA_WEB_ORIGIN=http://127.0.0.1:8765
AERA_WEB_BACKEND=0
AERA_WEB_BOT_USERNAME=AERAVPN_BOT
AERA_WEB_SUPPORT_DB=./support.sqlite3
AERA_WEB_ADMIN_IDS=
# Required for the connected account / checkout in production:
AERA_WEB_DATABASE_URL=
AERA_WEB_REDIS_URL=
AERA_WEB_APP_SECRET=
AERA_WEB_LOGIN_METHOD=oidc
AERA_WEB_OIDC_CLIENT_ID=
AERA_WEB_OIDC_CLIENT_SECRET=
AERA_WEB_WIDGET_SECRET=
AERA_WEB_SUBSCRIPTION_ORIGIN=
AERA_CHECKOUT_BRIDGE_KEY=
